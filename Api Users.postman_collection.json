	"item": [
		{
			"name": "GetAll test cases",
			"item": [
				{
					"name": "Get all users - ok all",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Assert that the response status code is 200.\r",
									"pm.test(\"Status code is 200\", function () {\r",
									"    pm.response.to.have.status(200);\r",
									"});\r",
									"// Assert that the response body is an array.\r",
									"let users = pm.response.json();\r",
									"// Assert that the response body contains at least one user.\r",
									"pm.test(\"Validate the correct number of users is three\", function () {\r",
									"    pm.expect(users).to.have.lengthOf(3);\r",
									"});\r",
									"// Assert that each user has the correct properties.\r",
									"pm.test(\"Validate the correct properties\", function () {\r",
									"    // properties for the user object\r",
									"    users.forEach(user => {\r",
									"        pm.expect(user).to.have.property(\"id\");\r",
									"        pm.expect(user).to.have.property(\"email\");\r",
									"        pm.expect(user).to.have.property(\"name\");\r",
									"        pm.expect(user).to.have.property(\"phone\");\r",
									"        pm.expect(user).to.have.property(\"password\");\r",
									"        pm.expect(user).to.have.property(\"tax_id\");\r",
									"        pm.expect(user).to.have.property(\"created_at\");\r",
									"        pm.expect(user).to.have.property(\"addresses\");\r",
									"        // properties for the address object\r",
									"        user.addresses.forEach(address => {\r",
									"            pm.expect(address).to.have.property(\"id\");\r",
									"            pm.expect(address).to.have.property(\"name\");\r",
									"            pm.expect(address).to.have.property(\"street\");\r",
									"            pm.expect(address).to.have.property(\"countryCode\");\r",
									"        });\r",
									"    });\r",
									"});\r",
									"\r",
									"pm.collectionVariables.set(\"id\", users[0].id);"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/users",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"users"
							]
						}
					},
					"response": []
				},
